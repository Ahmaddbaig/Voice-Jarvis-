ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=your_api_key_here

# OpenAI settings
OPENAI_MODEL=gpt-5.4
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
JARVIS_VOICE=verse

# Ollama settings for optional local inference.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# Context window. 4096 is plenty for short voice turns and is much faster to prefill
# on CPU than the Phase 1 original 16384. Bump if you add memory or agentic loops.
OLLAMA_NUM_CTX=4096
# Max generated tokens per turn. Hard ceiling; terse system prompt supplies brevity.
OLLAMA_NUM_PREDICT=80

# Attach a live webcam frame to every Ollama request? OFF by default â€” vision on CPU
# is extremely slow (40-130s extra per turn from image prompt prefill). The CLI REPL's
# `c` key still allows explicit "what do you see" questions. Turn this back ON only if
# you're building/testing vision features.
JARVIS_ALWAYS_SEE=false
JARVIS_CAMERA_INDEX=0
JARVIS_CAMERA_FPS=2

# ----- Phase 1: Voice loop -----
# Brain keep-alive â€” -1 = resident forever (research: cold-load tax is 5-10s on 8B Q4)
OLLAMA_KEEP_ALIVE=-1

# Wake-word engine (openWakeWord, hey_jarvis_v0.1.onnx)
# Empty = use openwakeword's bundled resources/models/hey_jarvis_v0.1.onnx
JARVIS_WAKE_MODEL=
# Stricter than the 0.5 default â€” relies on the two-stage gate for the rest
JARVIS_WAKE_THRESHOLD=0.70
# Empty = %LOCALAPPDATA%\Jarvis\logs\wake.log
JARVIS_WAKE_LOG=

# VAD timing (silero-vad ONNX)
JARVIS_VAD_SILENCE_MS=700
JARVIS_VAD_MIN_SPEECH_MS=250
JARVIS_VAD_MAX_S=30

# TTS (Kokoro primary; Piper ack; SAPI fallback)
JARVIS_TTS_VOICE=bm_george
JARVIS_KOKORO_LANG=b
JARVIS_PIPER_VOICE_DIR=models/piper
JARVIS_PIPER_VOICE_NAME=en_GB-alan-medium
JARVIS_ACK_PHRASE=Sir?

# Audio input device â€” empty = system default; substring match supported
JARVIS_INPUT_DEVICE=

# Global hotkey activation fallback (pynput format)
# Avoid Win+*, Ctrl+Alt+Del, F-keys
JARVIS_HOTKEY=<ctrl>+<alt>+j
