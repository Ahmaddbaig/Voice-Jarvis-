ASSISTANT_PROVIDER=ollama
OPENAI_API_KEY=your_api_key_here

# OpenAI settings
OPENAI_MODEL=gpt-5.4
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
JARVIS_VOICE=verse

# Ollama settings for local free inference. This repo uses the exact local model tag
# you have installed through Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_KEEP_ALIVE=5m

# Keeps the webcam open and sends the latest frame with each request.
JARVIS_ALWAYS_SEE=true
JARVIS_CAMERA_INDEX=0
JARVIS_CAMERA_FPS=2
