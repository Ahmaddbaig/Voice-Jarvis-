ASSISTANT_PROVIDER=ollama
OPENAI_API_KEY=your_api_key_here

# OpenAI settings
OPENAI_MODEL=gpt-5.4
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
JARVIS_VOICE=verse

# Ollama settings for local free inference. This repo uses the exact local model tag
# you have installed through Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Keeps the webcam open and sends the latest frame with each request.
JARVIS_ALWAYS_SEE=true
JARVIS_CAMERA_INDEX=0
JARVIS_CAMERA_FPS=2

# ----- Phase 1: Voice loop -----
# Brain keep-alive — pin gemma4 warm so first-turn latency is not 5+ seconds
OLLAMA_KEEP_ALIVE=24h

# Wake-word engine (openWakeWord, hey_jarvis_v0.1.onnx)
# Empty = use openwakeword's bundled resources/models/hey_jarvis_v0.1.onnx
JARVIS_WAKE_MODEL=
# Stricter than the 0.5 default — relies on the two-stage gate for the rest
JARVIS_WAKE_THRESHOLD=0.70
# Empty = %LOCALAPPDATA%\Jarvis\logs\wake.log
JARVIS_WAKE_LOG=

# VAD timing (silero-vad ONNX)
JARVIS_VAD_SILENCE_MS=700
JARVIS_VAD_MIN_SPEECH_MS=250
JARVIS_VAD_MAX_S=30

# TTS (Kokoro primary; Piper ack; SAPI fallback)
JARVIS_TTS_VOICE=bm_george
JARVIS_KOKORO_LANG=b
JARVIS_PIPER_VOICE_DIR=models/piper
JARVIS_PIPER_VOICE_NAME=en_GB-alan-medium
JARVIS_ACK_PHRASE=Sir?

# Audio input device — empty = system default; substring match supported
JARVIS_INPUT_DEVICE=

# Global hotkey activation fallback (pynput format)
# Avoid Win+*, Ctrl+Alt+Del, F-keys
JARVIS_HOTKEY=<ctrl>+<alt>+j
